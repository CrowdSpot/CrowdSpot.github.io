.announcement-banner
	background-color #284EF6
	color white
	text-align center
	padding 0.85em 2em
	position relative
	z-index 100
	letter-spacing 0.01em

	p
		margin 0
		font-size 0.875em
		line-height 1.5

	a
		color white
		text-decoration none
		font-weight 700
		border-bottom 2px solid rgba(white, 0.5)
		padding-bottom 1px
		transition border-color 0.2s ease

		&:hover
			border-bottom-color white
