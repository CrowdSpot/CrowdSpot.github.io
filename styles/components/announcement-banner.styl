$crowdlab-purple = #6E1AE4

.announcement-banner
	background-color rgba($crowdlab-purple, 0.08)
	border-bottom 1px solid rgba($crowdlab-purple, 0.25)
	color darken($crowdlab-purple, 10%)
	text-align center
	padding 0.7em 2em
	position fixed
	top 0
	left 0
	right 0
	z-index 10001
	letter-spacing 0.01em

	p
		margin 0
		font-size 0.8em
		line-height 1.5

	a
		color $crowdlab-purple
		text-decoration none
		font-weight 700
		border-bottom 1px solid rgba($crowdlab-purple, 0.4)
		padding-bottom 1px
		transition border-color 0.2s ease, opacity 0.2s ease

		&:hover
			border-bottom-color $crowdlab-purple
			opacity 0.75

// Push nav down to sit below the sticky banner
.site-header
	top 36px
