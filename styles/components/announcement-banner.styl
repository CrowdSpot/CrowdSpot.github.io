$crowdlab-purple = #6E1AE4

.announcement-banner
	background-color rgba($crowdlab-purple, 0.92)
	border-bottom 1px solid rgba($crowdlab-purple, 0.6)
	color rgba(white, 0.9)
	text-align center
	padding 0.7em 2em
	position fixed
	top 0
	left 0
	right 0
	z-index 10001
	letter-spacing 0.01em

	p
		margin 0
		font-size 0.8em
		line-height 1.5

	a
		color white
		text-decoration none
		font-weight 700
		border-bottom 1px solid rgba(white, 0.5)
		padding-bottom 1px
		transition border-color 0.2s ease, opacity 0.2s ease

		&:hover
			border-bottom-color white
			opacity 0.8

